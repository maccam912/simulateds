[configuration]
entry_symbol="gdext_rust_init"
compatibility_minimum="4.5"
reloadable=false

[libraries]
linux.debug.x86_64="res://native/bin/libtemplate_iroh.linux.x86_64.so"
linux.release.x86_64="res://native/bin/libtemplate_iroh.linux.x86_64.so"
windows.debug.x86_64="res://native/bin/template_iroh.windows.x86_64.dll"
windows.release.x86_64="res://native/bin/template_iroh.windows.x86_64.dll"
macos.debug="res://native/bin/libtemplate_iroh.macos.universal.dylib"
macos.release="res://native/bin/libtemplate_iroh.macos.universal.dylib"
android.debug.arm64="res://native/bin/libtemplate_iroh.android.arm64.so"
android.release.arm64="res://native/bin/libtemplate_iroh.android.arm64.so"
